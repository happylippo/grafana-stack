# Grafana
GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_LOG_LEVEL=info

# Authentik SSO (optional)
AUTHENTIK_ENABLED=false
AUTHENTIK_URL=https://auth.example.com
AUTHENTIK_APP_SLUG=grafana
AUTHENTIK_OAUTH_NAME=Authentik
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_ALLOW_SIGN_UP=true
AUTHENTIK_AUTO_LOGIN=false

# Prometheus
PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_RETENTION=30d

# Loki / Alloy
LOKI_IMAGE=grafana/loki:latest
ALLOY_IMAGE=grafana/alloy:latest
SOCKET_PROXY_IMAGE=lscr.io/linuxserver/socket-proxy:latest

# Exporters
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:latest
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:latest

# Networks
MONITORING_NETWORK=monitoring
TRAEFIK_DOCKER_NETWORK=proxy

# Traefik
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_HOST_RULE=Host(`grafana.example.com`)
TRAEFIK_MIDDLEWARES=default@file
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=cloudflare_resolver
